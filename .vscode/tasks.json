{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LC_ALL": "C"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build",
      "type": "shell",
      "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LC_ALL": "C"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": "CMake Configure"
    },
    {
      "label": "Build gradebook",
      "dependsOn": "CMake Build",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
