{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug gradebook",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Debug\\gradebook.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "LC_ALL",
          "value": "C"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\Users\\NYAYAKA\\Desktop\\mingw64\\bin\\gdb.exe",
